{
  "uid": "tasks",
  "title": "Digital Mirror - Worker Tasks",
  "tags": [
    "digital-mirror",
    "worker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pending tasks",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'pending'",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'running'",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Done (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'done' AND finished_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'failed' AND finished_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Facts (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM facts WHERE created_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Contradictions (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM contradictions WHERE created_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Facts per hour",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS facts FROM facts WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Contradictions per day",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at) AS time, COUNT(*) AS contradictions FROM contradictions WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent tasks",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.id, t.status, t.plugin, p.name AS person, t.since, t.until, t.attempts, t.items, t.facts, t.requested_by,\n  t.created_at, t.started_at, t.finished_at, t.last_error\nFROM collection_tasks t JOIN persons p ON p.id = t.person_id\nORDER BY t.created_at DESC LIMIT 50",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Housekeeping (job_metrics)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, job_type, metric, value FROM job_metrics\nWHERE job_type IN ('maintenance', 'feed', 'contradiction-audit') ORDER BY created_at DESC LIMIT 30",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}