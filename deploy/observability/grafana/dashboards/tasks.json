{
  "uid": "tasks",
  "title": "Digital Mirror - Tasks",
  "tags": [
    "digital-mirror",
    "tasks"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Running",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'running'",
          "refId": "A"
        }
      ],
      "description": "Tasks the worker is on now (as many at once as the LLM endpoint serves).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Ready",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'pending' AND (not_before IS NULL OR not_before <= now())",
          "refId": "A"
        }
      ],
      "description": "Pending tasks the worker can claim now.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Waiting",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'pending' AND not_before > now()",
          "refId": "A"
        }
      ],
      "description": "Pending tasks put back for later (a quota, an outage): they wait for their not_before.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Done (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'done' AND finished_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Failed (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FROM collection_tasks WHERE status = 'failed' AND finished_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Facts from tasks (24 h)",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(facts), 0) FROM collection_tasks WHERE finished_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Queue: running, then in the order the worker takes them",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN t.status = 'running' THEN NULL ELSE ROW_NUMBER() OVER (PARTITION BY t.status = 'running' ORDER BY (t.not_before > now()) NULLS FIRST, t.priority DESC, t.created_at) END AS \"#\", CASE WHEN t.status = 'running' THEN 'running' WHEN t.not_before > now() THEN 'waiting' ELSE 'ready' END AS state, p.name AS person, t.plugin, t.since, t.until, t.priority, COALESCE(t.operation, '') AS operation, t.attempts, t.started_at, t.heartbeat_at AS heartbeat, t.not_before, t.items, t.facts, COALESCE(t.last_error, '') AS last_error FROM collection_tasks t JOIN persons p ON p.id = t.person_id WHERE t.status IN ('running', 'pending') ORDER BY t.status = 'running' DESC, (t.not_before > now()) NULLS FIRST, t.priority DESC, t.created_at LIMIT 1000",
          "refId": "A"
        }
      ],
      "description": "Running tasks first, then the pending ones in claim order: highest priority, then oldest. A waiting task was put back until its not_before. items and facts of a running task are those of its earlier attempts.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "color": "green",
                        "index": 0
                      },
                      "ready": {
                        "color": "blue",
                        "index": 1
                      },
                      "waiting": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "#"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "fields": [
            "person"
          ]
        }
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Pending tasks per operation and plugin",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(operation, '(watch list and by hand)') AS operation, plugin, MAX(priority) AS priority, COUNT(*) FILTER (WHERE status = 'running') AS running, COUNT(*) FILTER (WHERE status = 'pending') AS pending, COUNT(*) FILTER (WHERE status = 'done') AS done, COUNT(*) FILTER (WHERE status = 'failed') AS failed FROM collection_tasks GROUP BY 1, 2 HAVING COUNT(*) FILTER (WHERE status IN ('running', 'pending')) > 0 ORDER BY 3 DESC, 1, 2",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Tasks finished per hour",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', finished_at) AS time, plugin || ' ' || status AS metric, COUNT(*) AS value FROM collection_tasks WHERE finished_at IS NOT NULL AND $__timeFilter(finished_at) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Finished recently",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.finished_at, t.status, p.name AS person, t.plugin, t.since, t.until, COALESCE(t.operation, '') AS operation, t.items, t.facts, t.finished_at - t.started_at AS took, t.attempts, COALESCE(t.last_error, '') AS last_error FROM collection_tasks t JOIN persons p ON p.id = t.person_id WHERE t.finished_at IS NOT NULL ORDER BY t.finished_at DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "description": "The last 200 tasks that ended: done, failed or cancelled.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "done": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "cancelled": {
                        "color": "gray",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "id": 10
    }
  ]
}