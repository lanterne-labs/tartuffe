    {
      "type": "timeseries",
      "title": "Verification funnel",
      "description": "Per day: verifications started (a challenge issued, the QR shown) against verifications that went through. The gap is the people who gave up at the app.",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(digital_mirror_auth_challenges_total{provider!=\"google\"}[1d]))",
          "legendFormat": "{{provider}} started",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (increase(digital_mirror_verifications_total{outcome=~\"ok|moved\"}[1d]))",
          "legendFormat": "{{provider}} done",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
