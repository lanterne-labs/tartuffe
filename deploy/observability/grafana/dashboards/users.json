    {
      "type": "timeseries",
      "title": "New accounts and verifications per day",
      "description": "Accounts opened per day (by their creation). A moved identity keeps no trace here.",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at) AS time, COUNT(*) AS accounts FROM app_users WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', verified_at) AS time, COUNT(*) AS verified FROM app_users WHERE verified_at IS NOT NULL AND $__timeFilter(verified_at) GROUP BY 1 ORDER BY 1",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Polls",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.slug AS poll, COUNT(DISTINCT pc.user_id) AS voters, COUNT(pc.*) AS votes, (SELECT COUNT(*) FROM poll_candidates c WHERE c.event_id = e.id) AS candidates, e.closes_at FROM poll_events e LEFT JOIN poll_choices pc ON pc.event_id = e.id GROUP BY e.id ORDER BY e.featured DESC, e.opens_at DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 9
    },
