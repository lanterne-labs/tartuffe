    {
      "type": "timeseries",
      "title": "Sign-ins",
      "description": "Per hour. refused: a bad or expired proof (an ID token Google did not sign for us, an expired challenge).",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (increase(digital_mirror_auth_signins_total[1h]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
