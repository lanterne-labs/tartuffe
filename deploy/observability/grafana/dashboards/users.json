    {
      "type": "stat",
      "title": "Verified share",
      "description": "Share of the real accounts (not noop) that verified their identity: the conversion of the passport step.",
      "datasource": {
        "type": "postgres",
        "uid": "mirrordb"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * COUNT(*) FILTER (WHERE verified_subject IS NOT NULL) / NULLIF(COUNT(*), 0) FROM app_users WHERE provider <> 'noop'",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
