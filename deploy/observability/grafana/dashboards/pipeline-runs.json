      "title": "Contradictions Found in Last Run",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mirrordb"
          },
          "rawSql": "SELECT c.created_at, p.name AS person, COALESCE(NULLIF(fa.fact_text_en,''), fa.fact_text) AS fact_a, COALESCE(NULLIF(fb.fact_text_en,''), fb.fact_text) AS fact_b, COALESCE(NULLIF(c.reason_en,''), c.reason) AS reason FROM contradictions c JOIN persons p ON p.id = c.person_id JOIN facts fa ON fa.id = c.fact_a_id JOIN facts fb ON fb.id = c.fact_b_id WHERE c.created_at >= (SELECT started_at FROM pipeline_runs ORDER BY id DESC LIMIT 1) ORDER BY c.created_at DESC",
          "format": "table",
          "refId": "A"
        }
