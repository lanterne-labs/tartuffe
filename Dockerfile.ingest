# The vote ingest (dm vote ingest, docs/vote/SPEC.md §8): the API's binary
# with what the ingest needs and the API does not.
# - bb verifies the ballot proofs. The binary shipped with @aztec/bb.js (the
#   version the frontend proves with, frontend/package.json) links the GNU
#   libc, so this image is Debian, not alpine like the API's.
# - git and ssh push the public mirror (--mirror-git, VOTE_MIRROR_SSH_KEY).
# - Node runs the ZKPassport verifier of the registrations (zkverifier/).
# - The election's setup files (vk and ballot.json of dm vote setup) are
#   committed under deploy/ingest/<slug>/ and copied to /app/vote/<slug>/.
# The host: the service `ingest` builds this file
# (HOST_DOCKERFILE_PATH=Dockerfile.ingest); its start command names the
# election.
FROM golang:1.24-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o dm .

FROM node:22-bookworm-slim AS bb
WORKDIR /bb
COPY frontend/package.json ./
RUN npm install --no-save --no-package-lock --ignore-scripts --no-audit --no-fund \
      "@aztec/bb.js@$(node -p "require('./package.json').dependencies['@aztec/bb.js']")" \
 && install -m 755 node_modules/@aztec/bb.js/build/amd64-linux/bb /usr/local/bin/bb \
 && /usr/local/bin/bb --version

FROM node:22-bookworm-slim AS zkverifier
WORKDIR /app/zkverifier
COPY zkverifier/package.json zkverifier/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY zkverifier/verify.mjs ./

FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git openssh-client tzdata \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/dm /usr/local/bin/dm
COPY --from=bb /usr/local/bin/bb /usr/local/bin/bb
COPY --from=zkverifier /app/zkverifier /app/zkverifier
COPY deploy/ingest /app/vote
ENV BB=/usr/local/bin/bb
# No ENTRYPOINT (see Dockerfile): the service's start command is the whole
# command line, e.g.
#   dm vote ingest presidentielle-2027 --vk /app/vote/presidentielle-2027/vk
#     --artifact /app/vote/presidentielle-2027/ballot.json
#     --mirror-dir /app/mirror --mirror-git git@github.com:tartuffeme/vote-data.git
CMD ["dm", "vote", "ingest"]
