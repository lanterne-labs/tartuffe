#!/bin/bash
# Drop-in replacement for ./dm that runs on the host.
# Usage: ./host plugin news search --targets "Marine Le Pen" --max-parse 10
# Same as: ./dm plugin news search --targets "Marine Le Pen" --max-parse 10

# Escape each argument for the remote shell so multi-word args survive SSH
ESCAPED=""
for arg in "$@"; do
    ESCAPED+=" $(printf '%q' "$arg")"
done
exec host ssh --service mirror -- dm$ESCAPED
