# --- Database Configuration ---
# Required: Connection string for your PostgreSQL database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=disable"

# --- OpenAI-compatible API ---
# Required: For embeddings, fact extraction, and contradiction detection
OPEN_AI_KEY="sk-..."
OPEN_AI_API="https://api.openai.com/v1"

# Optional: Model overrides (defaults shown)
OPEN_AI_CHAT_MODEL="gpt-4o-mini"
OPEN_AI_EMBED_MODEL="text-embedding-3-small"

# --- Web Server ---
# Optional: Port for the HTTP server (default: 8080)
PORT=8080

# Optional: Comma-separated list of allowed CORS origins for production
# If unset, allows localhost/127.0.0.1 origins for development
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# --- Google Custom Search API Credentials ---
# Required: For searching relevant content URLs
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
GOOGLE_CSE_ID="YOUR_GOOGLE_CSE_ID"

# --- Content Extraction Service API Keys ---
# Optional: Provide API key for AT LEAST ONE of the following services.
# The application will try Firecrawl first, then WebcrawlerAPI, then Apify.

# Option 1: Firecrawl API Key (Preferred)
FIRECRAWL_API_KEY="YOUR_FIRECRAWL_API_KEY"

# Option 2: WebcrawlerAPI Key (Alternative)
WEBCRAWLERAPI_KEY="YOUR_WEBCRAWLERAPI_KEY"

# Option 3: Apify API Key (Fallback)
APIFY_API_KEY="YOUR_APIFY_API_KEY"

# --- S3-Compatible Object Storage ---
# Required for photo upload (dm plugin photos search)
# Works with Cloudflare R2, MinIO, AWS S3, etc.
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=digital-mirror-photos
# Public URL for serving uploaded files (e.g. R2 public bucket URL)
STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Internal Metrics ---
# Optional: Internal metrics port for Prometheus scraping (default: 9090)
METRICS_PORT=9090

# --- Prometheus Remote Write (Grafana Cloud) ---
# Optional: Push metrics to a remote Prometheus-compatible endpoint.
# If URL is set, USER and PASSWORD are required.
PROMETHEUS_REMOTE_WRITE_URL=
PROMETHEUS_REMOTE_WRITE_USER=
PROMETHEUS_REMOTE_WRITE_PASSWORD=

# --- User Complaints (Tally) ---
# Optional: Required for `./dm complaints triage` to fetch and clear submissions.
# Tally form id (the slug from the form URL: tally.so/r/<id>) and a Tally API
# token (Account → API). The form is expected to have these fields:
#   textarea  : "What's wrong with this?" (the user's report)
#   hidden    : target_kind  (one of: fact | contradiction | stance)
#   hidden    : fact_id, contradiction_id, stance_id (only the matching one is populated)
#   hidden    : target_label (human-readable summary)
#   hidden    : source_url   (page the report was filed from)
TALLY_FORM_ID=
TALLY_API_TOKEN=

# --- Telegram Alerts ---
# Optional: Send Telegram alerts when LLM credits run low or calls fail
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Alert when balance drops below this amount (default: 2.0 USD)
BALANCE_ALERT_THRESHOLD_USD=2.0
# Optional: Minutes between proactive balance checks (default: 60)
BALANCE_CHECK_INTERVAL_MIN=60
# Optional: Hours to suppress duplicate alerts per provider (default: 6)
BALANCE_ALERT_COOLDOWN_HOURS=6

# --- Rate Limiting ---
# Optional: Rate limit per IP per minute (default: 100)
RATE_LIMIT_PER_MINUTE=100

# Optional: Maximum concurrent requests to content extraction APIs
# Default: 2 (suitable for Firecrawl free plan)
CONCURRENT_CRAWL_REQUESTS=2

# Optional: Delay between requests in milliseconds (to respect rate limits)
# Default: 1000 (1 second). With 2 workers, this means ~2 requests/second max.
# Set to 0 to disable delay (not recommended for free tier APIs).
CRAWL_REQUEST_DELAY_MS=1000

# --- Accounts and the voters' documents (backend/accounts) ---
# Comma-separated providers. Unset: noop locally, none on the host (no sign-in).
#   google      the accounts: Google sign-in, scope openid only (no e-mail, no name reach the site).
#   zkpassport  the document a voting key needs: a passport scanned with the ZKPassport app,
#               proved in zero knowledge; tied to no account.
#   noop        test accounts and test documents: any pseudonym, no proof. Never where the results must mean something.
AUTH_PROVIDERS=noop
# google: the OAuth client ID (Google Cloud console > APIs & Services > Credentials > OAuth client
# "Web application"; authorized redirect URIs: https://<site>/auth/google, http://localhost:<port>/auth/google).
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# The key of the HMAC under which the Google and document identifiers are stored, 32+ random
# characters (openssl rand -hex 32). Required by google and zkpassport. Keep it secret; changing
# it gives every Google user a new account and every document a new voting key.
# AUTH_SUBJECT_KEY=
# zkpassport: host name of the FRONTEND (the proofs are bound to it), e.g. tartuffe.me. Required.
ZKPASSPORT_DOMAIN=localhost
# Optional (defaults shown). Changing the scope gives every document a new identifier.
# ZKPASSPORT_SCOPE=tartuffe-voter
# ZKPASSPORT_MIN_AGE=18
# ZKPASSPORT_NATIONALITY=FRA        # ISO alpha-3, empty for any nationality
# ZKPASSPORT_DEV_MODE=false         # true accepts the app's mock documents (country ZKR): tests only
# ZKPASSPORT_RPC_URL=               # Ethereum RPC for the certificate registry reads (SDK public endpoint if empty)
# ZKPASSPORT_VERIFIER=              # path of zkverifier/verify.mjs (default: /app/zkverifier or ./zkverifier)
# ZKPASSPORT_NODE=node

# --- The vote (backend/vote, docs/vote/SPEC.md) ---
# The key of the vote log's checkpoints (dm vote log-key). Secret; set once, never change. The API
# and the ingest need it.
# VOTE_LOG_KEY=PRIVATE+KEY+tartuffe.me/vote-log+...
# The ingest's Nostr key (openssl rand -hex 32): it signs the acknowledgements and the checkpoints.
# VOTE_NOSTR_KEY=
# The relays are the setup entry's (dm vote setup --relays), not an environment variable.
# The ingest's mirror as a git repository (dm vote ingest --mirror-git git@github.com:lanterne-labs/vote-data.git):
# the private half of a write deploy key of that repository.
# VOTE_MIRROR_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
# The vote app is served from https://lanterne-labs.github.io: the API must allow that origin, and the
# ingest verifies passport proofs bound to that host.
# ALLOWED_ORIGINS=https://tartuffe.me,https://lanterne-labs.github.io
# ZKPASSPORT_DOMAIN=lanterne-labs.github.io   (the ingest; the API keeps the site's)
