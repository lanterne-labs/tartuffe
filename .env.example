# --- Database Configuration ---
# Required: Connection string for your PostgreSQL database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=disable"

# --- OpenAI-compatible API ---
# Required: For embeddings, fact extraction, and contradiction detection
OPEN_AI_KEY="sk-..."
OPEN_AI_API="https://api.openai.com/v1"

# Optional: Model overrides (defaults shown)
OPEN_AI_CHAT_MODEL="gpt-4o-mini"
OPEN_AI_EMBED_MODEL="text-embedding-3-small"

# --- Web Server ---
# Optional: Port for the HTTP server (default: 8080)
PORT=8080

# Optional: Comma-separated list of allowed CORS origins for production
# If unset, allows localhost/127.0.0.1 origins for development
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# --- Google Custom Search API Credentials ---
# Required: For searching relevant content URLs
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
GOOGLE_CSE_ID="YOUR_GOOGLE_CSE_ID"

# --- Content Extraction Service API Keys ---
# Optional: Provide API key for AT LEAST ONE of the following services.
# The application will try Firecrawl first, then WebcrawlerAPI, then Apify.

# Option 1: Firecrawl API Key (Preferred)
FIRECRAWL_API_KEY="YOUR_FIRECRAWL_API_KEY"

# Option 2: WebcrawlerAPI Key (Alternative)
WEBCRAWLERAPI_KEY="YOUR_WEBCRAWLERAPI_KEY"

# Option 3: Apify API Key (Fallback)
APIFY_API_KEY="YOUR_APIFY_API_KEY"

# --- S3-Compatible Object Storage ---
# Required for photo upload (dm plugin photos search)
# Works with Cloudflare R2, MinIO, AWS S3, etc.
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=digital-mirror-photos
# Public URL for serving uploaded files (e.g. R2 public bucket URL)
STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev

# --- Rate Limiting ---
# Optional: Maximum concurrent requests to content extraction APIs
# Default: 2 (suitable for Firecrawl free plan)
CONCURRENT_CRAWL_REQUESTS=2

# Optional: Delay between requests in milliseconds (to respect rate limits)
# Default: 1000 (1 second). With 2 workers, this means ~2 requests/second max.
# Set to 0 to disable delay (not recommended for free tier APIs).
CRAWL_REQUEST_DELAY_MS=1000
