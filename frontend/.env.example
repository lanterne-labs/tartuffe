# Optional: Override the API base URL. If unset, the frontend assumes the Go
# API is on the same host at port 8080.
VITE_API_BASE=

# Optional, at run time: the API as the SvelteKit server reaches it (a private
# network address) to fill the link previews; VITE_API_BASE when unset.
API_INTERNAL_URL=

# --- The vote (tartuffe-vote/2, docs/vote/SPEC.md) ---

# The data mirror the browser reads (SPEC §8.3): a directory URL serving the
# latest files (in dev, symlink the ingest's mirror into static/mirror and
# set /mirror), and/or a GitHub repository read through jsDelivr by the
# commit each checkpoint names (owner/repo). At least one.
VITE_VOTE_MIRROR=/mirror
VITE_VOTE_MIRROR_REPO=

# The log's verifier key, pinned in the app (else read from the mirror's
# log-key.txt): the browser checks every checkpoint's signature with it.
VITE_VOTE_LOG_KEY=

# The ZKPassport domain the proofs are bound to (the app's host name; the
# ingest verifies the same ZKPASSPORT_DOMAIN). VITE_ZKPASSPORT_DEV=1 accepts
# the app's mock documents; VITE_VOTE_SIMULATE_PASSPORT=1 adds a button that
# stands in for the app (local trials only, with the ingest's
# --dev-accept-any-passport).
VITE_ZKPASSPORT_DOMAIN=
VITE_ZKPASSPORT_DEV=
VITE_VOTE_SIMULATE_PASSPORT=

# The vote app's origin (https://lanterne-labs.github.io). When it is set and
# the page runs on another origin (the site's copy of the vote routes), the
# vote and complaint pages redirect there, same path: the passkeys, the keys
# and the ZKPassport domain belong to one origin. Unset in dev and in the
# vote app's own build.
VITE_VOTE_APP_ORIGIN=
