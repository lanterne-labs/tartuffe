# Optional: Override the API base URL. If unset, the frontend assumes the Go
# API is on the same host at port 8080.
VITE_API_BASE=

# Optional: Tally form id used by the user-complaints flow on the person page.
# When unset, the warning/report buttons are hidden so dev doesn't open a
# broken popup. Get the id from the form's URL slug (tally.so/r/<id>).
VITE_TALLY_FORM_ID=
